# Copy to .env and fill in. Never commit .env.

# Any OpenAI-compatible chat API that supports tool/function calling.
LLM_API_KEY=
# A small, low-cost model that supports tool calling. Check your provider
# for current model names.
LLM_MODEL=gpt-4o-mini
# Leave empty for OpenAI. For another provider, set its OpenAI-compatible
# base URL from that provider's docs (several offer free tiers).
LLM_BASE_URL=

# Token prices in USD per 1M tokens, from your provider's pricing page.
# Used only for cost tracking in traces and eval reports.
PRICE_INPUT_PER_1M=0
PRICE_OUTPUT_PER_1M=0

# Retrieval: bm25 (default, no API calls) or embedding
RETRIEVER=bm25
EMBEDDING_MODEL=text-embedding-3-small

MAX_STEPS=5
LOG_DIR=logs

# Optional: WhatsApp Cloud API (Meta). Without these, the webhook just
# returns the reply in its HTTP response.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
